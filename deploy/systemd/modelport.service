[Unit]
Description=RouteSmith multi-model intelligent gateway
Documentation=https://github.com/ShinyHero666/RouteSmith
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/modelport/modelport.env
Environment=RUST_LOG=model_port=info,tower_http=info
Environment=MODELPORT_STATE_DIR=/var/lib/modelport
ExecStart=/usr/local/bin/model-port
WorkingDirectory=/var/lib/modelport
Restart=always
RestartSec=3

DynamicUser=true
StateDirectory=modelport
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
